#!/bin/bash

BIN=/usr/bin/brave-origin

# Cleanup
if pgrep brave > /dev/null;then
  rm -f $HOME/.config/BraveSoftware/Brave-Origin-Nightly/Singleton*
fi

# Wayland check
if [ "${PIXELFLUX_WAYLAND,,}" == "true" ]; then
  WAYLAND="--ozone-platform=wayland"
fi

# Pelorus accessibility
if [ "${PELORUS,,}" == "true" ]; then
  ACCESSIBILITY="--force-renderer-accessibility"
fi

${BIN} \
  --no-first-run \
  --no-sandbox \
  --password-store=basic \
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' \
  --start-maximized \
  ${WAYLAND} \
  --test-type \
  --user-data-dir \
  ${ACCESSIBILITY} \
   "$@" > /dev/null 2>&1
